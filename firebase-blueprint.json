{
  "entities": {
    "Character": {
      "title": "Character",
      "description": "A character profile in the store",
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 100 },
        "genres": { "type": "array", "items": { "type": "string" }, "maxLength": 20 },
        "backstory": { "type": "string", "maxLength": 2000 },
        "openingMessage": { "type": "string", "maxLength": 1000 },
        "chatLink": { "type": "string", "maxLength": 500 },
        "avatarUrl": { "type": "string", "maxLength": 2000 },
        "likes": { "type": "integer" },
        "views": { "type": "integer" },
        "createdAt": { "type": "integer" }
      },
      "required": ["id", "name", "genres", "backstory", "openingMessage", "chatLink", "avatarUrl", "likes", "createdAt"]
    },
    "PuzzleImage": {
      "title": "PuzzleImage",
      "description": "A puzzle image associated with a character",
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "characterId": { "type": "string", "maxLength": 128 },
        "characterName": { "type": "string", "maxLength": 100 },
        "imageUrl": { "type": "string", "maxLength": 2000000 },
        "createdAt": { "type": "integer" }
      },
      "required": ["id", "characterId", "characterName", "imageUrl", "createdAt"]
    },
    "StickyNote": {
      "title": "StickyNote",
      "description": "A note on the communal sticky wall",
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "sender": { "type": "string", "maxLength": 100 },
        "content": { "type": "string", "maxLength": 400 },
        "color": { "type": "string", "maxLength": 50 },
        "x": { "type": "number" },
        "y": { "type": "number" },
        "createdAt": { "type": "integer" }
      },
      "required": ["id", "sender", "content", "color", "x", "y", "createdAt"]
    },
    "CharacterComment": {
      "title": "CharacterComment",
      "description": "A comment left on a character's profile",
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "characterId": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "userName": { "type": "string", "maxLength": 100 },
        "userPhoto": { "type": "string", "maxLength": 2000 },
        "content": { "type": "string", "maxLength": 1000 },
        "createdAt": { "type": "integer" }
      },
      "required": ["id", "characterId", "userId", "userName", "userPhoto", "content", "createdAt"]
    },
    "SiteConfig": {
      "title": "SiteConfig",
      "description": "Global configuration for the site appearance",
      "type": "object",
      "properties": {
        "id": { "type": "string", "enum": ["main"] },
        "backgroundUrl": { "type": "string", "maxLength": 2000 },
        "customLogo": { "type": "string", "maxLength": 2000000 },
        "updatedAt": { "type": "integer" }
      },
      "required": ["id", "updatedAt"]
    },
    "WynAnnouncement": {
      "title": "WynAnnouncement",
      "description": "An announcement on the notice board",
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 200 },
        "content": { "type": "string", "maxLength": 5000 },
        "tag": { "type": "string", "enum": ["Thông báo", "Lịch ra mắt", "Tâm sự", "Sự kiện"] },
        "isPinned": { "type": "boolean" },
        "createdAt": { "type": "integer" },
        "likes": { "type": "integer" }
      },
      "required": ["id", "title", "content", "tag", "createdAt", "likes"]
    },
    "CustomGenre": {
      "title": "CustomGenre",
      "description": "A dynamically added character genre",
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 50 },
        "createdAt": { "type": "integer" }
      },
      "required": ["id", "name", "createdAt"]
    }
  },
  "firestore": {
    "characters": {
      "schema": "Character",
      "description": "Collection of character profiles"
    },
    "puzzle_images": {
      "schema": "PuzzleImage",
      "description": "Collection of puzzle images"
    },
    "sticky_notes": {
      "schema": "StickyNote",
      "description": "Collection of communal sticky notes"
    },
    "character_comments": {
      "schema": "CharacterComment",
      "description": "Collection of user comments on characters"
    },
    "site_config": {
      "schema": "SiteConfig",
      "description": "Singleton collection for site-wide settings"
    },
    "announcements": {
      "schema": "WynAnnouncement",
      "description": "Collection of board announcements"
    },
    "genres": {
      "schema": "CustomGenre",
      "description": "Collection of custom character genres"
    }
  }
}
